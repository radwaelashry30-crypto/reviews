APP_NAME=Baseera
APP_VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list is not supported here -- set as a JSON array if overriding via env:
# FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DEFAULT_SENTIMENT_MODEL=bert
# Set ENABLE_BERT=false on low-RAM hosts (e.g. Render's free 512MB tier) --
# the 670MB BERT weights won't fit alongside PyTorch's own baseline memory
# use there. CNN2D (~12MB) is unaffected.
ENABLE_BERT=true
ENABLE_CNN2D=true
ENABLE_TRANSLATION=false
# Off-by-default flag for the fake-review module (see MODEL_CARD.md for the
# validated ensemble behind it). ABSA (aspect-based sentiment) has no
# equivalent flag -- it runs on CNN2D, already loaded above, not a separate
# external model -- see app/ml/absa.py.
ENABLE_FAKE_REVIEW_MODULE=false
# On a low-RAM host (e.g. Render's free 512MB tier), pair the line above with
# FAKE_REVIEW_TFIDF_ONLY=true -- drops the ~257MB DistilBERT component and
# serves the ~350KB TF-IDF+LogReg classifier alone (answers less often, not
# less reliably -- see app/ml/fake_review_detection.py's module docstring).
FAKE_REVIEW_TFIDF_ONLY=false
MAX_REVIEW_LENGTH=2000
MAX_BATCH_SIZE=64

LOG_LEVEL=INFO

# Number of trusted reverse proxies in front of this app (Render/Vercel/any
# load balancer = 1). Used to safely pick the real client IP out of
# X-Forwarded-For for rate limiting. Set to 0 for local dev with no proxy.
TRUSTED_PROXY_HOPS=1

# Off by default -- the app stays open exactly as before unless you opt in.
# Set REQUIRE_API_KEY=true and at least one real key to lock the API down:
REQUIRE_API_KEY=false
# API_KEYS=["a-real-random-key-here"]

# Optional. Enables durable persistence of sentiment analyses, feedback, and
# batch-upload history (see DATABASE_SETUP.md). Unset by default -- the app
# runs fully without it (predictions still work, uploads persist to local
# JSON files for 7 days instead of a database). Never commit a real value
# here; set it via a real environment variable or a local, gitignored .env.
# DATABASE_URL=postgresql://user:password@host/dbname
