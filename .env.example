APP_NAME=Olist Marketplace Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list is not supported here -- set as a JSON array if overriding via env:
# FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DEFAULT_SENTIMENT_MODEL=bert
ENABLE_TRANSLATION=false
ALLOW_EXTERNAL_MODEL_DOWNLOADS=false
MAX_REVIEW_LENGTH=2000
MAX_BATCH_SIZE=64

LOG_LEVEL=INFO
